{
  "name": "metropolis-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen-version": "node scripts/gen-version.mjs",
    "predev": "node scripts/gen-version.mjs",
    "dev": "vite",
    "prebuild": "node scripts/gen-version.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test \"test/*.test.mjs\" && tsx --test test/mount.test.tsx test/rebuild-prompt.test.tsx test/store-dispatch.test.tsx test/error-boundary.test.tsx test/store-reset-capture.test.tsx",
    "test:mount": "tsx --test test/mount.test.tsx"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.12",
    "typescript": "~5.6.2",
    "vite": "^5.4.11"
  }
}
