# Dependencies
node_modules/

# Claude Code session state (per-window, machine-local)
.claude/settings.local.json
.claude/.identity*
.claude/.last-ping*
.claude/worktrees/
.claude-heartbeat-*
.claude-session-key
.claude-session-map.json

# Secrets — never commit anywhere
service-account.json
serviceAccountKey*.json
*-credentials.json
*.pem
*.key
*.cert
*.p8
.env
.env.*
!.env.example
*.env
*.env.local

# Build / logs
dist/
out/
.next/
*.log
firebase-debug.log

# OS noise
.DS_Store
Thumbs.db
nul
# Microsoft Office lock files (e.g. docs/~$cloud.md while Word has it open)
~$*

# claude-plan-checker.js's cross-process mutex directory (BUG-194); should
# never persist past a checkPlan() call, but ignore it in case a crashed
# process leaves it behind before the next acquirer's timeout clears it.
.plan-checker.lock

# Go build artifacts
*.exe
*.test
*.out
/bin/

# Go saves (curated fixtures are the exception; committed explicitly)
*.ndjson.gz
!fixtures/**/*.ndjson.gz

# tools/bow-server.js rendered output (a stale BOW DB snapshot baked into
# HTML, 400KB+); the template bow-ui-template.html IS source and stays tracked.
bow-ui.html
# Scratch/backup files agents leave beside source; the content belongs in a
# BOW item or a commit, never as loose debris (sitrep 2026-08-17 A7).
*.other-agent.bak
_edges_scratch.txt
# coordination-keeper.js's silent renewal log
.claude/keeper.log

# FEAT-065 dev-mode feedback file-drop inbox: runtime-generated free-text
# submissions and their processed/error sidecars — never committed (this
# is player/dev-typed content landing on disk, not source or fixtures).
data/devfeedback/
